{
  "name": "monitorx",
  "version": "1.0.0",
  "description": "MonitorX is a background monitoring engine for dynamic web pages, featuring session persistence, parallel watchers, and webhook-based alerting.",
  "keywords": [
    "MonitorX"
  ],
  "homepage": "https://github.com/Niktar1/MonitorX#readme",
  "bugs": {
    "url": "https://github.com/Niktar1/MonitorX/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niktar1/MonitorX.git"
  },
  "license": "MIT",
  "author": "Niktar1",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop MonitorX",
    "pm2:restart": "pm2 restart MonitorX",
    "pm2:logs": "pm2 logs MonitorX",
    "pm2:monit": "pm2 monit",
    "build": "pkg index.js --targets node18-win-x64 --output dist/MonitorX.exe",
    "postbuild": "xcopy /E /I /Y public dist\\public"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "playwright": "^1.59.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1",
    "pm2": "^6.0.14"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "public/*",
      "public/css/*",
      "public/js/*",
      "node_modules/playwright-core/.local-browsers/**/*"
    ],
    "scripts": [
      "*.js",
      "core/**/*.js",
      "web/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
